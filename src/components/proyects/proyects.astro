---

---
<!-- Espaciador para separar de la sección anterior -->
<div class="h-32 bg-transparent"></div>

<section 
  id="proyectos"
  class="section relative z-[20] text-white flex items-center justify-center p-6 min-h-screen">
  <div class="max-w-6xl mx-auto w-full">
    <!-- Título de la sección -->
    <div class="text-center mb-16">
      <h2 class="text-4xl lg:text-5xl font-bold mb-6 bg-gradient-to-r from-cyan-400 to-blue-500 bg-clip-text text-transparent">
        Proyectos Destacados
      </h2>
      <p class="text-lg lg:text-xl text-gray-300 max-w-3xl mx-auto">
        Una selección de mis trabajos más recientes donde combino creatividad y tecnología para crear experiencias digitales únicas.
      </p>
    </div>

    <!-- Grid de proyectos -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
      
      <!-- Proyecto 1 -->
     <div class="group bg-[#FAF9F6]/80 backdrop-blur-md rounded-2xl overflow-hidden shadow-xl hover:shadow-[0_0_25px_rgba(212,165,116,0.3)] transition-all duration-500 hover:-translate-y-2 border border-[#9CAF88]/20">
  <!-- 🔹 Fondo con imagen -->
        <div class="aspect-video relative overflow-hidden">
          <img
            src="/disenoInteriores.webp"
            alt="Proyecto de Diseño de Interiores"
            class="absolute inset-0 w-full h-full object-cover transform group-hover:scale-110 transition-transform duration-700"
          />
          <!-- Overlay cálido para contraste -->
          <div class="absolute inset-0 bg-gradient-to-t from-[#2F2F2F]/80 via-transparent to-transparent"></div>

          <!-- Barras decorativas en tonos dorados -->
          <div class="absolute bottom-4 left-4 right-4">
            <div class="w-full h-2 bg-[#D4A574]/30 rounded-full mb-2"></div>
            <div class="w-3/4 h-2 bg-[#9CAF88]/20 rounded-full"></div>
          </div>
        </div>

  <!-- Contenido -->
  <div class="p-6">
    <h3 class="text-xl font-bold mb-2 text-[#9CAF88] group-hover:text-[#D4A574] transition-colors">
      Diseño de Interiores Web
    </h3>

    <p class="text-[#2F2F2F]/80 text-sm mb-4 leading-relaxed">
      Aplicación web full-stack con Astro. Diseño elegante, sostenible y optimizado.
    </p>

    <!-- Etiquetas -->
    <div class="flex flex-wrap gap-2 mb-4">
      <span class="px-2 py-1 bg-[#9CAF88]/15 text-[#9CAF88] text-xs rounded-lg border border-[#9CAF88]/30">Astro</span>
      <span class="px-2 py-1 bg-[#D4A574]/15 text-[#D4A574] text-xs rounded-lg border border-[#D4A574]/30">Tailwind CSS</span>
    </div>

    <!-- Enlaces -->
    <div class="flex gap-3">
      <a href="https://disenointeriores.vercel.app" class="text-[#9CAF88] hover:text-[#D4A574] text-sm font-medium transition-colors">
        Ver Demo →
      </a>
      <!-- <a href="#" class="text-[#2F2F2F]/60 hover:text-[#2F2F2F] text-sm font-medium transition-colors"> -->
        <!-- Código → -->
      <!-- </a> -->
    </div>
  </div>
</div>



      <!-- Proyecto 2 -->
      <div class="group bg-gray-800/50 backdrop-blur-sm rounded-2xl overflow-hidden shadow-2xl hover:shadow-blue-500/20 transition-all duration-500 hover:-translate-y-2">
       <div class="aspect-video relative overflow-hidden">
          <img
            src="/clinica-medica.webp"
            alt="Proyecto de Clínica Médica"
            class="absolute inset-0 w-full h-full object-cover transform group-hover:scale-110 transition-transform duration-700"
          />
          <!-- Overlay cálido para contraste -->
          <div class="absolute inset-0 bg-gradient-to-t from-white via-blue-50 to-white via-transparent to-transparent"></div>

          <!-- Barras decorativas en tonos dorados -->
          <div class="absolute bottom-4 left-4 right-4">
            <div class="w-full h-2 bg-blue-500/30 rounded-full mb-2"></div>
            <div class="w-3/4 h-2 bg-blue-500/20 rounded-full"></div>
          </div>
        </div>
        <div class="p-6">
          <h3 class="text-xl font-bold mb-2 text-blue-400 group-hover:text-blue-300 transition-colors">
            Clinica Medica Web
          </h3>
          <p class="text-gray-300 text-sm mb-4 leading-relaxed">
            Diseño y desarrollo de aplicación web con interfaz intuitiva y experiencia de usuario optimizada.
          </p>
          <div class="flex flex-wrap gap-2 mb-4">
            <span class="px-2 py-1 bg-blue-500/20 text-blue-300 text-xs rounded-lg">Next.js</span>
            <span class="px-2 py-1 bg-blue-500/20 text-blue-300 text-xs rounded-lg">TypeScript</span>
            <span class="px-2 py-1 bg-blue-500/20 text-blue-300 text-xs rounded-lg">Tailwind CSS</span>
          </div>
          <div class="flex gap-3">
            <a href="#" class="text-blue-400 hover:text-blue-300 text-sm font-medium transition-colors">
              Ver Demo →
            </a>
            <a href="#" class="text-gray-400 hover:text-white text-sm font-medium transition-colors">
              Código →
            </a>
          </div>
        </div>
      </div>

      <!-- Proyecto 3 -->
      <div class="group bg-gray-800/50 backdrop-blur-sm rounded-2xl overflow-hidden shadow-2xl hover:shadow-emerald-500/20 transition-all duration-500 hover:-translate-y-2">
        <div class="aspect-video relative overflow-hidden">
          <img
            src="/store.webp"
            alt="Proyecto de Diseño de Interiores"
            class="absolute inset-0 w-full h-full object-cover transform group-hover:scale-110 transition-transform duration-700"
          />
          <!-- Overlay cálido para contraste -->
          <div class="absolute inset-0 bg-gradient-to-t from-[#2F2F2F]/80 via-transparent to-transparent"></div>

          <!-- Barras decorativas en tonos dorados -->
          <div class="absolute bottom-4 left-4 right-4">
            <div class="w-full h-2 bg-[#D4A574]/30 rounded-full mb-2"></div>
            <div class="w-3/4 h-2 bg-[#9CAF88]/20 rounded-full"></div>
          </div>
        </div>

        <div class="p-6">
          <h3 class="text-xl font-bold mb-2 text-emerald-400 group-hover:text-emerald-300 transition-colors">
            E-commerce Web
          </h3>
          <p class="text-gray-300 text-sm mb-4 leading-relaxed">
            Plataforma completa de comercio electrónico con panel administrativo y procesamiento de pagos.
          </p>
          <div class="flex flex-wrap gap-2 mb-4">
            <span class="px-2 py-1 bg-emerald-500/20 text-emerald-300 text-xs rounded-lg">Next.js</span>
            <span class="px-2 py-1 bg-teal-500/20 text-teal-300 text-xs rounded-lg">Stripe</span>
            <span class="px-2 py-1 bg-green-500/20 text-green-300 text-xs rounded-lg">PostgreSQL</span>
          </div>
          <div class="flex gap-3">
            <a href="#" class="text-emerald-400 hover:text-emerald-300 text-sm font-medium transition-colors">
              Ver Demo →
            </a>
            <a href="#" class="text-gray-400 hover:text-white text-sm font-medium transition-colors">
              Código →
            </a>
          </div>
        </div>
      </div>

    </div>

    <!-- Call to Action -->
    <div class="text-center mt-16">
      <p class="text-gray-300 mb-6 text-lg">
        ¿Interesado en trabajar juntos?
      </p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <a href="/contact" class="bg-gradient-to-r from-cyan-500 to-blue-600 hover:from-cyan-600 hover:to-blue-700 px-8 py-3 rounded-lg font-semibold transition-all duration-300 transform hover:scale-105">
          Contáctame
        </a>
        <a href="/projects" class="border border-cyan-400 hover:bg-cyan-400/10 px-8 py-3 rounded-lg font-semibold transition-all duration-300">
          Ver Más Proyectos
        </a>
      </div>
    </div>

  </div>
</section>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    //console.log('✅ Sección de proyectos cargada correctamente');
    
    const proyectosSection = document.getElementById('proyectos');
    if (proyectosSection) {
      console.log('✅ Elemento proyectos encontrado:', proyectosSection);
      console.log('📐 Posición de proyectos:', proyectosSection.getBoundingClientRect());
    } else {
      console.error('❌ Elemento proyectos NO encontrado');
    }

    // Observador para detectar cuando la sección entra en el viewport
    const observer = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          console.log('👀 Sección de proyectos VISIBLE en pantalla');
          const element = entry.target as HTMLElement;
          element.style.opacity = '1';
          element.style.transform = 'translateY(0)';
        }
      });
    });

    if (proyectosSection) {
      // Asegurar visibilidad inicial
      proyectosSection.style.opacity = '1';
      proyectosSection.style.transform = 'translateY(0)';
      observer.observe(proyectosSection);
    }
  });
</script>