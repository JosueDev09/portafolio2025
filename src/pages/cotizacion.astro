---
import Layout from '../layouts/Layout.astro';
---

<Layout 
  title="Cotización de Proyecto - Josue Dev" 
  description="Cotización detallada y personalizada para tu proyecto de desarrollo web. Proceso transparente y profesional."
  showMenu={false}
>
  <section class="quote-page">
    <div class="quote-container">
      
      <!-- Header con botón de regreso -->
      <div class="quote-header">
        <a href="javascript:history.back()" class="back-btn">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/>
          </svg>
          <span>Volver</span>
        </a>
        
        <div class="actions-header">
          <button class="action-btn edit-btn" id="editBtn">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/>
            </svg>
            <span>Editar</span>
          </button>
          
          <button class="action-btn save-btn" id="saveBtn" style="display: none;">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
            </svg>
            <span>Guardar</span>
          </button>
          
          <button class="action-btn print-btn" id="printBtn">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 17h2a2 2 0 002-2v-4a2 2 0 00-2-2H5a2 2 0 00-2 2v4a2 2 0 002 2h2m2 4h6a2 2 0 002-2v-4a2 2 0 00-2-2H9a2 2 0 00-2 2v4a2 2 0 002 2zm8-12V5a2 2 0 00-2-2H9a2 2 0 00-2 2v4h10z"/>
            </svg>
            <span>Imprimir</span>
          </button>
        </div>
      </div>

      <!-- Documento de Cotización -->
      <div class="quote-document">
        
        <!-- Hero de la cotización -->
        <div class="quote-hero">
          <div class="quote-title-section">
            <h1 class="quote-main-title">
              <span class="gradient-text">Cotización</span>
              <span class="quote-number" contenteditable="false" data-editable>#COT-2024-001</span>
            </h1>
            <p class="quote-subtitle">Propuesta de Desarrollo Web Profesional</p>
          </div>
          
          <div class="quote-meta">
            <div class="meta-item">
              <span class="meta-label">Fecha:</span>
              <span class="meta-value" contenteditable="false" data-editable>04 Noviembre 2024</span>
            </div>
            <div class="meta-item">
              <span class="meta-label">Válida hasta:</span>
              <span class="meta-value" contenteditable="false" data-editable>04 Diciembre 2024</span>
            </div>
            <div class="meta-item">
              <span class="meta-label">Estado:</span>
              <span class="status-badge active">Activa</span>
            </div>
          </div>
        </div>

        <!-- Información de las partes -->
        <div class="parties-info">
          <div class="party-card developer">
            <h3>De:</h3>
            <div class="party-details">
              <p class="party-name" contenteditable="false" data-editable>Josué Dev</p>
              <p class="party-role">Desarrollador Full Stack</p>
              <p class="party-contact" contenteditable="false" data-editable>esymbel.mkt2025@gmail.com</p>
              <p class="party-contact" contenteditable="false" data-editable>+52 (123) 456-7890</p>
            </div>
          </div>
          
          <div class="party-card client">
            <h3>Para:</h3>
            <div class="party-details">
              <p class="party-name" contenteditable="false" data-editable>Nombre del Cliente</p>
              <p class="party-role" contenteditable="false" data-editable>Empresa / Organización</p>
              <p class="party-contact" contenteditable="false" data-editable>cliente@email.com</p>
              <p class="party-contact" contenteditable="false" data-editable>+52 (XXX) XXX-XXXX</p>
            </div>
          </div>
        </div>

        <!-- Descripción del proyecto -->
        <div class="project-section">
          <h2 class="section-title">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/>
            </svg>
            Descripción del Proyecto
          </h2>
          <div class="project-description" contenteditable="false" data-editable>
            <p><strong>Desarrollo de un sitio web moderno, rápido y optimizado</strong>, creado con tecnologías de vanguardia (Astro, React y Tailwind CSS). El sitio será completamente responsive (adaptado a móviles, tablets y computadoras) e incluirá integración de envío de correos electrónicos desde formularios de contacto u otros módulos definidos.</p>
          </div>
        </div>

        <!-- Alcance del Proyecto -->
        <div class="scope-section">
          <h2 class="section-title">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"/>
            </svg>
            Alcance del Proyecto
          </h2>
          
          <div class="scope-grid">
            <div class="scope-card">
              <h3>🧱 Tecnologías</h3>
              <div class="scope-content" contenteditable="false" data-editable>
                <p><strong>Frontend:</strong> Astro + React + Tailwind CSS</p>
                <p><strong>Integraciones:</strong> API de envío de correos (Node.js backend, Resend, Nodemailer o servicio SMTP)</p>
                <p><strong>Diseño:</strong> UI/UX moderno, minimalista y adaptado a la marca del cliente</p>
                <p><strong>Hosting y Dominio:</strong> Se puede alojar en Vercel, Netlify o servidor propio del cliente</p>
              </div>
            </div>

            <div class="scope-card">
              <h3>📄 Estructura del Sitio</h3>
              <div class="scope-content" contenteditable="false" data-editable>
                <ol class="structure-list">
                  <li><strong>Inicio</strong> – Hero principal con presentación de marca o servicios</li>
                  <li><strong>Servicios / Productos</strong> – Sección informativa o catálogo visual</li>
                  <li><strong>Nosotros</strong> – Descripción de la empresa y su misión</li>
                  <li><strong>Contacto</strong> – Formulario con envío de correo electrónico y validación</li>
                  <li><strong>Footer</strong> – Enlaces, redes sociales, aviso de privacidad</li>
                </ol>
                <p class="structure-note">(Se pueden ajustar las secciones según requerimientos del cliente.)</p>
              </div>
            </div>
          </div>
        </div>

        <!-- Funcionalidades Incluidas -->
        <div class="features-section">
          <h2 class="section-title">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/>
            </svg>
            Funcionalidades Incluidas
          </h2>
          
          <div class="features-grid" contenteditable="false" data-editable>
            <div class="feature-item">
              <div class="feature-icon">✅</div>
              <p>Diseño responsive adaptable a cualquier dispositivo</p>
            </div>
            <div class="feature-item">
              <div class="feature-icon">✅</div>
              <p>Animaciones suaves (interactividad con React / Framer Motion opcional)</p>
            </div>
            <div class="feature-item">
              <div class="feature-icon">✅</div>
              <p>Optimización SEO básica (meta etiquetas, estructura semántica)</p>
            </div>
            <div class="feature-item">
              <div class="feature-icon">✅</div>
              <p>Integración de correo electrónico (formulario que envía mensajes directamente)</p>
            </div>
            <div class="feature-item">
              <div class="feature-icon">✅</div>
              <p>Optimización de rendimiento (carga rápida y puntajes altos en Lighthouse)</p>
            </div>
            <div class="feature-item">
              <div class="feature-icon">✅</div>
              <p>Configuración de favicon, logo y branding</p>
            </div>
            <div class="feature-item">
              <div class="feature-icon">✅</div>
              <p>Integración de Google Analytics o similar (opcional)</p>
            </div>
          </div>
        </div>

        <!-- Tabla de servicios -->
        <div class="services-section">
          <h2 class="section-title">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-3 7h3m-3 4h3m-6-4h.01M9 16h.01"/>
            </svg>
            Desglose de Servicios
          </h2>
          
          <div class="services-table">
            <div class="table-header">
              <div class="col-service">Servicio</div>
              <div class="col-description">Descripción</div>
              <div class="col-quantity">Cantidad</div>
              <div class="col-price">Precio Unit.</div>
              <div class="col-total">Total</div>
            </div>
            
            <div class="table-body" id="servicesTableBody">
              <!-- Servicio 1 -->
              <div class="table-row" data-service-row>
                <div class="col-service" contenteditable="false" data-editable>Diseño y Maquetación</div>
                <div class="col-description" contenteditable="false" data-editable>Diseño visual, estructura y desarrollo en Astro + Tailwind</div>
                <div class="col-quantity" contenteditable="false" data-editable data-type="number">1</div>
                <div class="col-price" contenteditable="false" data-editable data-type="currency">$3,500.00</div>
                <div class="col-total" data-total>$3,500.00</div>
              </div>
              
              <!-- Servicio 2 -->
              <div class="table-row" data-service-row>
                <div class="col-service" contenteditable="false" data-editable>Programación e Integraciones</div>
                <div class="col-description" contenteditable="false" data-editable>Formularios, envío de correos, componentes dinámicos React</div>
                <div class="col-quantity" contenteditable="false" data-editable data-type="number">1</div>
                <div class="col-price" contenteditable="false" data-editable data-type="currency">$2,000.00</div>
                <div class="col-total" data-total>$2,000.00</div>
              </div>
              
              <!-- Servicio 3 -->
              <div class="table-row" data-service-row>
                <div class="col-service" contenteditable="false" data-editable>Optimización y Pruebas</div>
                <div class="col-description" contenteditable="false" data-editable>SEO básico, responsive, pruebas multi-dispositivo</div>
                <div class="col-quantity" contenteditable="false" data-editable data-type="number">1</div>
                <div class="col-price" contenteditable="false" data-editable data-type="currency">$1,000.00</div>
                <div class="col-total" data-total>$1,000.00</div>
              </div>
            </div>
          </div>
          
          <button class="add-service-btn" id="addServiceBtn" style="display: none;">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/>
            </svg>
            Agregar Servicio
          </button>
        </div>

        <!-- Resumen de costos -->
        <div class="cost-summary">
          <div class="summary-rows">
            <div class="summary-row">
              <span class="summary-label">Subtotal:</span>
              <span class="summary-value" id="subtotal">$6,500.00</span>
            </div>
            <div class="summary-row total-row">
              <span class="summary-label">Total:</span>
              <span class="summary-value" id="total">$6,500.00 MXN</span>
            </div>
          </div>
          <div class="cost-note">
            <p>💡 El costo puede variar según número de secciones o integraciones adicionales (e-commerce, panel admin, blog, etc.).</p>
          </div>
        </div>

        <!-- Servicios Opcionales -->
        <div class="optional-section">
          <h2 class="section-title">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v6m0 0v6m0-6h6m-6 0H6"/>
            </svg>
            Servicios Opcionales
          </h2>
          
          <div class="optional-grid">
            <div class="optional-card">
              <h4>🌐 Hosting + Dominio</h4>
              <p class="optional-description" contenteditable="false" data-editable>Configuración y puesta en línea anual</p>
              <p class="optional-price" contenteditable="false" data-editable>$1,200 MXN</p>
            </div>
            
            <div class="optional-card">
              <h4>✨ Animaciones Avanzadas</h4>
              <p class="optional-description" contenteditable="false" data-editable>Transiciones y efectos visuales premium (Framer Motion)</p>
              <p class="optional-price" contenteditable="false" data-editable>$800 MXN</p>
            </div>
            
            <div class="optional-card">
              <h4>📝 Blog Administrable (CMS)</h4>
              <p class="optional-description" contenteditable="false" data-editable>Sección dinámica administrable (ej. Sanity, Contentful)</p>
              <p class="optional-price" contenteditable="false" data-editable>$1,500 MXN</p>
            </div>
          </div>
        </div>

        <!-- Plan de pagos -->
        <div class="payment-section">
          <h2 class="section-title">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 9V7a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2m2 4h10a2 2 0 002-2v-6a2 2 0 00-2-2H9a2 2 0 00-2 2v6a2 2 0 002 2zm7-5a2 2 0 11-4 0 2 2 0 014 0z"/>
            </svg>
            Forma de Pago
          </h2>
          
          <div class="payment-plan">
            <div class="payment-item">
              <div class="payment-badge">50%</div>
              <div class="payment-details">
                <h4>Anticipo Inicial</h4>
                <p class="payment-amount" data-payment="50">$3,250.00 MXN</p>
                <p class="payment-description">Anticipo para iniciar el proyecto</p>
              </div>
            </div>
            
            <div class="payment-item">
              <div class="payment-badge">50%</div>
              <div class="payment-details">
                <h4>Pago Final</h4>
                <p class="payment-amount" data-payment="50">$3,250.00 MXN</p>
                <p class="payment-description">Restante al finalizar y entregar el sitio</p>
              </div>
            </div>
          </div>
        </div>

        <!-- Cronograma -->
        <div class="timeline-section">
          <h2 class="section-title">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/>
            </svg>
            Cronograma Estimado del Proyecto
          </h2>
          
          <div class="timeline-content">
            <div class="timeline-item">
              <div class="timeline-marker">1</div>
              <div class="timeline-info">
                <h4>Diseño UI/UX</h4>
                <p contenteditable="false" data-editable>Boceto, estructura visual, paleta de colores, tipografía</p>
                <span class="timeline-duration">3 días</span>
              </div>
            </div>
            
            <div class="timeline-item">
              <div class="timeline-marker">2</div>
              <div class="timeline-info">
                <h4>Maquetación en Astro + Tailwind</h4>
                <p contenteditable="false" data-editable>Implementación del layout, navegación, componentes base</p>
                <span class="timeline-duration">4 días</span>
              </div>
            </div>
            
            <div class="timeline-item">
              <div class="timeline-marker">3</div>
              <div class="timeline-info">
                <h4>Integración de React + Formularios</h4>
                <p contenteditable="false" data-editable>Animaciones, formularios funcionales, lógica de correo</p>
                <span class="timeline-duration">3 días</span>
              </div>
            </div>
            
            <div class="timeline-item">
              <div class="timeline-marker">4</div>
              <div class="timeline-info">
                <h4>Optimización y Pruebas</h4>
                <p contenteditable="false" data-editable>Ajustes, responsive, SEO, pruebas en dispositivos</p>
                <span class="timeline-duration">2 días</span>
              </div>
            </div>
          </div>
          
          <div class="timeline-summary">
            <p><strong>Duración total estimada:</strong> <span contenteditable="false" data-editable>12 días hábiles aproximadamente</span></p>
          </div>
        </div>

        <!-- Entregables -->
        <div class="deliverables-section">
          <h2 class="section-title">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 13V6a2 2 0 00-2-2H6a2 2 0 00-2 2v7m16 0v5a2 2 0 01-2 2H6a2 2 0 01-2-2v-5m16 0h-2.586a1 1 0 00-.707.293l-2.414 2.414a1 1 0 01-.707.293h-3.172a1 1 0 01-.707-.293l-2.414-2.414A1 1 0 006.586 13H4"/>
            </svg>
            Entregables
          </h2>
          
          <div class="deliverables-grid" contenteditable="false" data-editable>
            <div class="deliverable-item">
              <div class="deliverable-icon">📦</div>
              <p>Sitio web funcional y optimizado</p>
            </div>
            <div class="deliverable-item">
              <div class="deliverable-icon">💻</div>
              <p>Código fuente completo (GitHub o repositorio privado)</p>
            </div>
            <div class="deliverable-item">
              <div class="deliverable-icon">🚀</div>
              <p>Instrucciones de despliegue o deploy directo (Vercel/Netlify)</p>
            </div>
            <div class="deliverable-item">
              <div class="deliverable-icon">🛠️</div>
              <p>Soporte técnico posterior al lanzamiento por 15 días</p>
            </div>
          </div>
        </div>

        <!-- Términos y condiciones -->
        <div class="terms-section">
          <h2 class="section-title">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/>
            </svg>
            Garantía y Soporte
          </h2>
          
          <div class="warranty-box">
            <h3>🛡️ Garantía Incluida</h3>
            <p contenteditable="false" data-editable>Se incluyen <strong>15 días de soporte post-entrega</strong> para correcciones menores o ajustes visuales.</p>
            <p class="warranty-note" contenteditable="false" data-editable>(No aplica a nuevas secciones o cambios de funcionalidad.)</p>
          </div>
          
          <div class="terms-content" contenteditable="false" data-editable>
            <ul class="terms-list">
              <li><strong>Soporte:</strong> 15 días de soporte técnico gratuito post-entrega para correcciones y ajustes.</li>
              <li><strong>Cambios:</strong> Cambios menores y ajustes visuales incluidos. Nuevas secciones o funcionalidades requieren nueva cotización.</li>
              <li><strong>Pagos:</strong> 50% anticipo para iniciar, 50% restante al finalizar y entregar el sitio.</li>
              <li><strong>Propiedad:</strong> El cliente obtiene todos los derechos del código al completar el pago total.</li>
              <li><strong>Confidencialidad:</strong> Toda la información del proyecto es confidencial y protegida.</li>
              <li><strong>Entregables:</strong> Código fuente completo, documentación e instrucciones de deploy.</li>
            </ul>
          </div>
          
          <div class="terms-link">
            <a href="/proceso-trabajo" class="view-legal-btn">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/>
              </svg>
              Ver Documento Legal Completo
            </a>
          </div>
        </div>

        <!-- Firma y aceptación -->
        <div class="signature-section">
          <h2 class="section-title">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 3.732z"/>
            </svg>
            Aceptación de la Cotización
          </h2>
          
          <div class="signature-grid">
            <div class="signature-box">
              <div class="signature-line"></div>
              <p class="signature-label">Firma del Desarrollador</p>
              <p class="signature-name" contenteditable="false" data-editable>Josué Dev</p>
              <p class="signature-date">Fecha: _________________</p>
            </div>
            
            <div class="signature-box">
              <div class="signature-line"></div>
              <p class="signature-label">Firma del Cliente</p>
              <p class="signature-name" contenteditable="false" data-editable>Nombre del Cliente</p>
              <p class="signature-date">Fecha: _________________</p>
            </div>
          </div>
          
          <div class="acceptance-note">
            <p>Al firmar esta cotización, ambas partes aceptan los términos, condiciones y cronograma establecidos en este documento.</p>
          </div>
        </div>

        <!-- Footer de la cotización -->
        <div class="quote-footer">
          <p class="footer-text">Para cualquier consulta sobre esta cotización, contáctame a <a href="mailto:esymbel.mkt2025@gmail.com">esymbel.mkt2025@gmail.com</a></p>
          <p class="footer-note">Esta cotización fue generada el <span contenteditable="false" data-editable>04 de Noviembre de 2024</span> y es válida por 30 días.</p>
        </div>

      </div>
    </div>
  </section>

  <style>
    /* 🎨 ESTILOS PARA LA PÁGINA DE COTIZACIÓN */
    
    .quote-page {
      background: linear-gradient(135deg, #0f172a 0%, #1e293b 100%);
      min-height: 100vh;
      padding: 2rem 1rem;
      color: #e2e8f0;
    }

    .quote-container {
      max-width: 1200px;
      margin: 0 auto;
    }

    /* Header con acciones */
    .quote-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 2rem;
      flex-wrap: wrap;
      gap: 1rem;
    }

    .back-btn {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      padding: 12px 24px;
      background: rgba(34, 197, 94, 0.1);
      border: 1px solid rgba(34, 197, 94, 0.2);
      border-radius: 12px;
      color: #22c55e;
      text-decoration: none;
      font-weight: 500;
      transition: all 0.3s ease;
      backdrop-filter: blur(8px);
    }

    .back-btn:hover {
      background: rgba(34, 197, 94, 0.15);
      border-color: rgba(34, 197, 94, 0.4);
      transform: translateY(-2px);
    }

    .actions-header {
      display: flex;
      gap: 1rem;
    }

    .action-btn {
      display: inline-flex;
      align-items: center;
      gap: 0.5rem;
      padding: 12px 24px;
      border: none;
      border-radius: 12px;
      font-weight: 600;
      cursor: pointer;
      transition: all 0.3s ease;
      backdrop-filter: blur(8px);
    }

    .edit-btn {
      background: rgba(59, 130, 246, 0.1);
      border: 1px solid rgba(59, 130, 246, 0.2);
      color: #3b82f6;
    }

    .edit-btn:hover {
      background: rgba(59, 130, 246, 0.15);
      border-color: rgba(59, 130, 246, 0.4);
    }

    .save-btn {
      background: rgba(34, 197, 94, 0.1);
      border: 1px solid rgba(34, 197, 94, 0.2);
      color: #22c55e;
    }

    .save-btn:hover {
      background: rgba(34, 197, 94, 0.15);
      border-color: rgba(34, 197, 94, 0.4);
    }

    .print-btn {
      background: rgba(168, 85, 247, 0.1);
      border: 1px solid rgba(168, 85, 247, 0.2);
      color: #a855f7;
    }

    .print-btn:hover {
      background: rgba(168, 85, 247, 0.15);
      border-color: rgba(168, 85, 247, 0.4);
    }

    /* Documento principal */
    .quote-document {
      background: rgba(30, 41, 59, 0.5);
      border: 1px solid rgba(71, 85, 105, 0.3);
      border-radius: 24px;
      padding: 3rem;
      backdrop-filter: blur(10px);
      box-shadow: 0 20px 60px rgba(0, 0, 0, 0.3);
    }

    /* Hero de la cotización */
    .quote-hero {
      text-align: center;
      padding: 2rem 0 3rem;
      border-bottom: 2px solid rgba(59, 130, 246, 0.2);
      margin-bottom: 3rem;
    }

    .quote-title-section {
      margin-bottom: 2rem;
    }

    .quote-main-title {
      font-size: clamp(3rem, 8vw, 5rem);
      font-weight: 900;
      line-height: 1;
      margin-bottom: 1rem;
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 0.5rem;
    }

    .gradient-text {
      background: linear-gradient(135deg, #3b82f6 0%, #a855f7 100%);
      background-clip: text;
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
    }

    .quote-number {
      font-size: clamp(1.5rem, 3vw, 2rem);
      color: #94a3b8;
      font-weight: 600;
    }

    .quote-subtitle {
      font-size: clamp(1.2rem, 2vw, 1.5rem);
      color: #cbd5e1;
      font-weight: 400;
    }

    .quote-meta {
      display: flex;
      justify-content: center;
      gap: 3rem;
      flex-wrap: wrap;
    }

    .meta-item {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 0.5rem;
    }

    .meta-label {
      color: #94a3b8;
      font-size: 0.875rem;
      font-weight: 500;
    }

    .meta-value {
      color: #f1f5f9;
      font-size: 1.1rem;
      font-weight: 600;
    }

    .status-badge {
      padding: 0.5rem 1rem;
      border-radius: 8px;
      font-size: 0.875rem;
      font-weight: 600;
    }

    .status-badge.active {
      background: rgba(34, 197, 94, 0.2);
      color: #22c55e;
      border: 1px solid rgba(34, 197, 94, 0.3);
    }

    /* Información de las partes */
    .parties-info {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
      gap: 2rem;
      margin-bottom: 3rem;
    }

    .party-card {
      background: rgba(15, 23, 42, 0.6);
      border-radius: 16px;
      padding: 2rem;
      border: 1px solid;
    }

    .party-card.developer {
      border-color: rgba(59, 130, 246, 0.3);
    }

    .party-card.client {
      border-color: rgba(168, 85, 247, 0.3);
    }

    .party-card h3 {
      color: #94a3b8;
      font-size: 0.875rem;
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: 0.1em;
      margin-bottom: 1rem;
    }

    .party-details .party-name {
      color: #f1f5f9;
      font-size: 1.5rem;
      font-weight: 700;
      margin-bottom: 0.5rem;
    }

    .party-details .party-role {
      color: #94a3b8;
      font-size: 1rem;
      margin-bottom: 1rem;
    }

    .party-details .party-contact {
      color: #cbd5e1;
      font-size: 0.9rem;
      margin: 0.25rem 0;
    }

    /* Secciones generales */
    .project-section,
    .services-section,
    .payment-section,
    .timeline-section,
    .terms-section,
    .signature-section {
      margin-bottom: 3rem;
    }

    .section-title {
      display: flex;
      align-items: center;
      gap: 0.75rem;
      font-size: 1.5rem;
      font-weight: 700;
      color: #3b82f6;
      margin-bottom: 1.5rem;
      padding-bottom: 0.75rem;
      border-bottom: 2px solid rgba(59, 130, 246, 0.2);
    }

    .section-title svg {
      color: #3b82f6;
    }

    /* Descripción del proyecto */
    .project-description {
      background: rgba(15, 23, 42, 0.4);
      border: 1px solid rgba(71, 85, 105, 0.3);
      border-radius: 12px;
      padding: 1.5rem;
      line-height: 1.7;
    }

    .project-description p {
      color: #cbd5e1;
      margin-bottom: 1rem;
    }

    .project-description ul {
      list-style: none;
      padding: 0;
      margin: 1rem 0;
    }

    .project-description li {
      color: #cbd5e1;
      padding: 0.5rem 0;
      padding-left: 1.5rem;
      position: relative;
    }

    .project-description li::before {
      content: "✓";
      position: absolute;
      left: 0;
      color: #22c55e;
      font-weight: bold;
    }

    /* Alcance del Proyecto */
    .scope-section {
      margin-bottom: 3rem;
    }

    .scope-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(350px, 1fr));
      gap: 2rem;
    }

    .scope-card {
      background: rgba(15, 23, 42, 0.6);
      border: 1px solid rgba(59, 130, 246, 0.3);
      border-radius: 16px;
      padding: 2rem;
      transition: all 0.3s ease;
    }

    .scope-card:hover {
      transform: translateY(-4px);
      border-color: rgba(59, 130, 246, 0.5);
      box-shadow: 0 10px 30px rgba(59, 130, 246, 0.2);
    }

    .scope-card h3 {
      color: #60a5fa;
      font-size: 1.25rem;
      font-weight: 700;
      margin-bottom: 1.5rem;
      display: flex;
      align-items: center;
      gap: 0.5rem;
    }

    .scope-content {
      color: #cbd5e1;
      line-height: 1.7;
    }

    .scope-content p {
      margin: 0.75rem 0;
      font-size: 0.95rem;
    }

    .scope-content strong {
      color: #f1f5f9;
    }

    .structure-list {
      list-style: none;
      padding: 0;
      margin: 1rem 0;
      counter-reset: structure-counter;
    }

    .structure-list li {
      counter-increment: structure-counter;
      padding: 0.5rem 0;
      padding-left: 2rem;
      position: relative;
      line-height: 1.6;
    }

    .structure-list li::before {
      content: counter(structure-counter) ".";
      position: absolute;
      left: 0;
      color: #3b82f6;
      font-weight: bold;
      font-size: 1.1rem;
    }

    .structure-note {
      margin-top: 1rem;
      font-size: 0.875rem;
      color: #94a3b8;
      font-style: italic;
    }

    /* Funcionalidades */
    .features-section {
      margin-bottom: 3rem;
    }

    .features-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
      gap: 1rem;
    }

    .feature-item {
      background: rgba(15, 23, 42, 0.4);
      border: 1px solid rgba(34, 197, 94, 0.2);
      border-radius: 12px;
      padding: 1.25rem;
      display: flex;
      align-items: flex-start;
      gap: 1rem;
      transition: all 0.3s ease;
    }

    .feature-item:hover {
      background: rgba(15, 23, 42, 0.6);
      border-color: rgba(34, 197, 94, 0.4);
      transform: translateX(4px);
    }

    .feature-icon {
      font-size: 1.5rem;
      flex-shrink: 0;
    }

    .feature-item p {
      color: #cbd5e1;
      margin: 0;
      font-size: 0.95rem;
      line-height: 1.6;
    }

    /* Nota de costo */
    .cost-note {
      margin-top: 1.5rem;
      padding-top: 1.5rem;
      border-top: 1px solid rgba(71, 85, 105, 0.3);
    }

    .cost-note p {
      color: #94a3b8;
      font-size: 0.9rem;
      text-align: center;
      margin: 0;
      line-height: 1.6;
    }

    /* Servicios Opcionales */
    .optional-section {
      margin-bottom: 3rem;
    }

    .optional-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
      gap: 1.5rem;
    }

    .optional-card {
      background: rgba(15, 23, 42, 0.6);
      border: 1px solid rgba(168, 85, 247, 0.3);
      border-radius: 12px;
      padding: 1.5rem;
      text-align: center;
      transition: all 0.3s ease;
    }

    .optional-card:hover {
      transform: translateY(-4px);
      border-color: rgba(168, 85, 247, 0.5);
      box-shadow: 0 10px 30px rgba(168, 85, 247, 0.2);
    }

    .optional-card h4 {
      color: #a855f7;
      font-size: 1.1rem;
      font-weight: 700;
      margin-bottom: 0.75rem;
    }

    .optional-description {
      color: #94a3b8;
      font-size: 0.9rem;
      margin-bottom: 1rem;
      line-height: 1.5;
    }

    .optional-price {
      color: #22c55e;
      font-size: 1.25rem;
      font-weight: 800;
      margin: 0;
    }

    /* Timeline duración */
    .timeline-duration {
      display: inline-block;
      background: rgba(34, 197, 94, 0.2);
      color: #22c55e;
      padding: 0.25rem 0.75rem;
      border-radius: 6px;
      font-size: 0.875rem;
      font-weight: 600;
      margin-top: 0.5rem;
    }

    /* Entregables */
    .deliverables-section {
      margin-bottom: 3rem;
    }

    .deliverables-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
      gap: 1.5rem;
    }

    .deliverable-item {
      background: rgba(15, 23, 42, 0.4);
      border: 1px solid rgba(59, 130, 246, 0.3);
      border-radius: 12px;
      padding: 1.5rem;
      text-align: center;
      transition: all 0.3s ease;
    }

    .deliverable-item:hover {
      background: rgba(15, 23, 42, 0.6);
      border-color: rgba(59, 130, 246, 0.5);
      transform: scale(1.05);
    }

    .deliverable-icon {
      font-size: 2.5rem;
      margin-bottom: 1rem;
    }

    .deliverable-item p {
      color: #cbd5e1;
      margin: 0;
      font-size: 0.95rem;
      line-height: 1.5;
    }

    /* Garantía */
    .warranty-box {
      background: rgba(34, 197, 94, 0.1);
      border: 1px solid rgba(34, 197, 94, 0.3);
      border-radius: 12px;
      padding: 1.5rem;
      margin-bottom: 2rem;
      text-align: center;
    }

    .warranty-box h3 {
      color: #22c55e;
      font-size: 1.25rem;
      font-weight: 700;
      margin-bottom: 1rem;
    }

    .warranty-box p {
      color: #cbd5e1;
      margin: 0.5rem 0;
      font-size: 1rem;
      line-height: 1.6;
    }

    .warranty-note {
      color: #94a3b8;
      font-size: 0.875rem;
      font-style: italic;
    }

    /* Tabla de servicios */
    .services-table {
      background: rgba(15, 23, 42, 0.4);
      border: 1px solid rgba(71, 85, 105, 0.3);
      border-radius: 12px;
      overflow: hidden;
    }

    .table-header {
      display: grid;
      grid-template-columns: 2fr 3fr 1fr 1.5fr 1.5fr;
      gap: 1rem;
      background: rgba(59, 130, 246, 0.1);
      padding: 1rem 1.5rem;
      font-weight: 600;
      color: #3b82f6;
      font-size: 0.875rem;
      text-transform: uppercase;
      letter-spacing: 0.05em;
    }

    .table-body {
      padding: 0;
    }

    .table-row {
      display: grid;
      grid-template-columns: 2fr 3fr 1fr 1.5fr 1.5fr;
      gap: 1rem;
      padding: 1rem 1.5rem;
      border-bottom: 1px solid rgba(71, 85, 105, 0.2);
      transition: all 0.3s ease;
      align-items: center;
    }

    .table-row:hover {
      background: rgba(59, 130, 246, 0.05);
    }

    .table-row:last-child {
      border-bottom: none;
    }

    .col-service {
      color: #f1f5f9;
      font-weight: 600;
    }

    .col-description {
      color: #94a3b8;
      font-size: 0.9rem;
    }

    .col-quantity,
    .col-price {
      color: #cbd5e1;
      text-align: center;
    }

    .col-total {
      color: #22c55e;
      font-weight: 700;
      text-align: right;
    }

    [contenteditable="true"] {
      outline: 2px solid rgba(59, 130, 246, 0.4);
      outline-offset: 2px;
      border-radius: 4px;
      padding: 4px;
      transition: all 0.3s ease;
    }

    [contenteditable="true"]:focus {
      outline: 2px solid rgba(59, 130, 246, 0.8);
      background: rgba(59, 130, 246, 0.1);
    }

    .add-service-btn {
      margin-top: 1rem;
      display: inline-flex;
      align-items: center;
      gap: 0.5rem;
      padding: 0.75rem 1.5rem;
      background: rgba(34, 197, 94, 0.1);
      border: 1px solid rgba(34, 197, 94, 0.2);
      border-radius: 8px;
      color: #22c55e;
      font-weight: 600;
      cursor: pointer;
      transition: all 0.3s ease;
    }

    .add-service-btn:hover {
      background: rgba(34, 197, 94, 0.15);
      border-color: rgba(34, 197, 94, 0.4);
    }

    /* Resumen de costos */
    .cost-summary {
      background: linear-gradient(135deg, rgba(59, 130, 246, 0.1), rgba(168, 85, 247, 0.1));
      border: 1px solid rgba(59, 130, 246, 0.3);
      border-radius: 12px;
      padding: 2rem;
      margin-top: 2rem;
    }

    .summary-rows {
      max-width: 400px;
      margin-left: auto;
    }

    .summary-row {
      display: flex;
      justify-content: space-between;
      padding: 0.75rem 0;
      border-bottom: 1px solid rgba(71, 85, 105, 0.2);
    }

    .summary-row:last-child {
      border-bottom: none;
    }

    .summary-label {
      color: #cbd5e1;
      font-weight: 500;
    }

    .summary-value {
      color: #f1f5f9;
      font-weight: 600;
      font-size: 1.1rem;
    }

    .total-row {
      margin-top: 1rem;
      padding-top: 1.5rem;
      border-top: 2px solid rgba(59, 130, 246, 0.3);
    }

    .total-row .summary-label {
      color: #3b82f6;
      font-size: 1.25rem;
      font-weight: 700;
    }

    .total-row .summary-value {
      color: #22c55e;
      font-size: 1.5rem;
      font-weight: 800;
    }

    /* Plan de pagos */
    .payment-plan {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
      gap: 1.5rem;
    }

    .payment-item {
      background: rgba(15, 23, 42, 0.6);
      border: 1px solid rgba(34, 197, 94, 0.3);
      border-radius: 12px;
      padding: 1.5rem;
      transition: all 0.3s ease;
    }

    .payment-item:hover {
      transform: translateY(-4px);
      border-color: rgba(34, 197, 94, 0.5);
      box-shadow: 0 10px 30px rgba(34, 197, 94, 0.2);
    }

    .payment-badge {
      background: linear-gradient(135deg, #22c55e 0%, #16a34a 100%);
      color: white;
      width: 60px;
      height: 60px;
      border-radius: 12px;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 1.25rem;
      font-weight: 800;
      margin-bottom: 1rem;
    }

    .payment-details h4 {
      color: #f1f5f9;
      font-size: 1.1rem;
      font-weight: 600;
      margin-bottom: 0.5rem;
    }

    .payment-amount {
      color: #22c55e;
      font-size: 1.5rem;
      font-weight: 800;
      margin: 0.75rem 0;
    }

    .payment-description {
      color: #94a3b8;
      font-size: 0.875rem;
      line-height: 1.5;
    }

    /* Cronograma */
    .timeline-content {
      background: rgba(15, 23, 42, 0.4);
      border: 1px solid rgba(71, 85, 105, 0.3);
      border-radius: 12px;
      padding: 2rem;
    }

    .timeline-item {
      display: flex;
      align-items: flex-start;
      gap: 1.5rem;
      margin-bottom: 2rem;
      position: relative;
    }

    .timeline-item:last-child {
      margin-bottom: 0;
    }

    .timeline-item::before {
      content: "";
      position: absolute;
      left: 20px;
      top: 50px;
      width: 2px;
      height: calc(100% + 2rem);
      background: linear-gradient(180deg, rgba(59, 130, 246, 0.5), rgba(168, 85, 247, 0.5));
    }

    .timeline-item:last-child::before {
      display: none;
    }

    .timeline-marker {
      min-width: 40px;
      width: 40px;
      height: 40px;
      background: linear-gradient(135deg, #3b82f6 0%, #a855f7 100%);
      color: white;
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
      font-weight: 700;
      flex-shrink: 0;
      z-index: 1;
    }

    .timeline-info h4 {
      color: #f1f5f9;
      font-size: 1.1rem;
      font-weight: 600;
      margin-bottom: 0.5rem;
    }

    .timeline-info p {
      color: #94a3b8;
      font-size: 0.9rem;
      line-height: 1.6;
    }

    .timeline-summary {
      background: rgba(59, 130, 246, 0.1);
      border: 1px solid rgba(59, 130, 246, 0.3);
      border-radius: 8px;
      padding: 1rem 1.5rem;
      margin-top: 1.5rem;
      text-align: center;
    }

    .timeline-summary p {
      color: #cbd5e1;
      margin: 0;
    }

    .timeline-summary strong {
      color: #3b82f6;
    }

    .timeline-summary span {
      color: #22c55e;
      font-weight: 600;
    }

    /* Términos y condiciones */
    .terms-content {
      background: rgba(15, 23, 42, 0.4);
      border: 1px solid rgba(71, 85, 105, 0.3);
      border-radius: 12px;
      padding: 1.5rem;
    }

    .terms-list {
      list-style: none;
      padding: 0;
      margin: 0;
    }

    .terms-list li {
      color: #cbd5e1;
      padding: 1rem 0;
      padding-left: 1.5rem;
      position: relative;
      border-bottom: 1px solid rgba(71, 85, 105, 0.2);
      line-height: 1.6;
    }

    .terms-list li:last-child {
      border-bottom: none;
    }

    .terms-list li::before {
      content: "•";
      position: absolute;
      left: 0;
      color: #3b82f6;
      font-weight: bold;
      font-size: 1.5rem;
    }

    .terms-list strong {
      color: #f1f5f9;
    }

    .terms-link {
      margin-top: 1.5rem;
      text-align: center;
    }

    .view-legal-btn {
      display: inline-flex;
      align-items: center;
      gap: 0.5rem;
      padding: 1rem 2rem;
      background: rgba(168, 85, 247, 0.1);
      border: 1px solid rgba(168, 85, 247, 0.3);
      border-radius: 12px;
      color: #a855f7;
      text-decoration: none;
      font-weight: 600;
      transition: all 0.3s ease;
    }

    .view-legal-btn:hover {
      background: rgba(168, 85, 247, 0.15);
      border-color: rgba(168, 85, 247, 0.5);
      transform: translateY(-2px);
    }

    /* Firma */
    .signature-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
      gap: 2rem;
      margin-bottom: 2rem;
    }

    .signature-box {
      background: rgba(15, 23, 42, 0.4);
      border: 1px solid rgba(71, 85, 105, 0.3);
      border-radius: 12px;
      padding: 2rem;
      text-align: center;
    }

    .signature-line {
      width: 100%;
      height: 100px;
      border-bottom: 2px solid rgba(71, 85, 105, 0.5);
      margin-bottom: 1rem;
    }

